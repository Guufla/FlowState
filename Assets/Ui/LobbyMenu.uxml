<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Image tint-color="rgb(0, 0, 0)" name="Background" source="" style="height: 85%; width: 85%; opacity: 0.86; top: auto; bottom: auto; position: relative; left: auto; right: auto; align-items: auto; align-self: center; align-content: auto; justify-content: flex-start; margin-top: 4%; margin-bottom: 4%; border-top-width: 14px; border-right-width: 14px; border-bottom-width: 14px; border-left-width: 14px; visibility: visible; overflow: visible; display: flex; aspect-ratio: auto; min-width: auto; min-height: auto; scale: 1 1; margin-right: 4%; margin-left: 4%; border-top-left-radius: 6%; border-top-right-radius: 6%; border-bottom-right-radius: 6%; border-bottom-left-radius: 6%; border-left-color: rgb(0, 150, 255); border-right-color: rgb(0, 150, 255); border-top-color: rgb(0, 150, 255); border-bottom-color: rgb(0, 150, 255); -unity-material: url(&quot;&quot;); background-color: rgb(0, 0, 0); font-size: initial;">
        <ui:Label text="Flow State" name="Title" style="align-items: center; align-self: center; align-content: auto; width: 478px; height: auto; background-color: rgba(0, 0, 0, 0); font-size: 100px; color: rgb(255, 255, 255); -unity-text-align: upper-center; letter-spacing: 9px; -unity-text-auto-size: best-fit 30px 3000px;"/>
        <ui:VisualElement style="flex-grow: 1; align-self: center; flex-direction: row; flex-wrap: nowrap; width: 783px;">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-self: stretch; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; align-items: auto; width: 60%;">
                <ui:Label text="Lobby Info" name="LobbyInfo" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center; justify-content: flex-start; align-content: auto; align-self: center; font-size: 45px;"/>
                <ui:Label text="Lobby Name: " name="LobbyName" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center; justify-content: flex-start; align-content: auto; align-self: center; font-size: 23px;"/>
                <ui:Label text="Lobby Code: " name="LobbyCode" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center; justify-content: flex-start; align-content: auto; align-self: center; font-size: 23px;"/>
                <ui:Label text="Lobby Players (0): " name="LobbyPlayerCount" style="color: rgb(255, 255, 255); -unity-text-align: upper-center; align-items: center; justify-content: flex-start; align-content: auto; align-self: center; font-size: 23px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-self: flex-start; border-top-width: 29px; border-right-width: 29px; border-bottom-width: 29px; border-left-width: 29px; width: 40%;">
                <ui:Button text="Start Game" name="StartGame" style="align-self: center; align-items: auto; width: 129px; height: 49px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Image>
</ui:UXML>
